# Copy this file to .env and fill in DISCORD_TOKEN. Never commit .env.

# Bot token from https://discord.com/developers/applications > your app > Bot > Reset Token
DISCORD_TOKEN=

# Optional: a server ID for instant command registration while testing.
# Leave empty to register the /3d commands globally (can take up to an hour to appear).
DISCORD_GUILD_ID=

# Where projects, the database and logs are stored (default: ./data)
DATA_DIR=./data

# Worker processes that build models at the same time (default: half the CPU cores)
MAX_CONCURRENT_JOBS=2
# Running + queued jobs allowed per user
MAX_JOBS_PER_USER=2
# A job is killed after this many seconds
JOB_TIMEOUT_SECONDS=900
# Memory cap per worker process on Linux (MB)
WORKER_MEMORY_MB=6144

# Upload limits for photos
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=40000000
MAX_IMAGES_PER_JOB=6
# Used when Discord does not report the channel's attachment limit
DEFAULT_UPLOAD_LIMIT_MB=10

# Discord user IDs (comma separated) that may view/edit every project
ADMIN_USER_IDS=

# Upload the code-drawn icon set as application emojis on start
REGISTER_APP_EMOJIS=true

# Keep the files of this many recent versions per project (older ones keep their settings and can be rebuilt)
KEEP_VERSIONS=30

LOG_LEVEL=INFO

# Optional private download links for packages larger than Discord's upload limit.
# Needs a reachable HTTPS address (for example a reverse proxy) and a long random secret.
DOWNLOAD_SERVER=false
DOWNLOAD_HOST=0.0.0.0
DOWNLOAD_PORT=8765
DOWNLOAD_BASE_URL=
DOWNLOAD_SECRET=
DOWNLOAD_TTL_HOURS=24

# Optional: Blender executable used only by the test suite / quality report to
# double-check exported FBX files. Not needed to run the bot.
BLENDER_PATH=
